rules_version = '2';

// Firebase Storage rules for SoulSpect app
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read and write to shared uploads folder
    // This is for temporary uploads or shared resources
    match /uploads/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Specific rules for different file types
    match /users/{userId}/images/{fileName} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId
        && (fileName.matches('.*\\.(jpg|jpeg|png|gif|webp)$'))
        && resource.size < 10 * 1024 * 1024; // 10MB max
    }
    
    match /users/{userId}/videos/{fileName} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId
        && (fileName.matches('.*\\.(mp4|webm|mov|avi)$'))
        && resource.size < 100 * 1024 * 1024; // 100MB max
    }
    
    match /users/{userId}/audio/{fileName} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId
        && (fileName.matches('.*\\.(mp3|wav|m4a|aac|ogg)$'))
        && resource.size < 25 * 1024 * 1024; // 25MB max
    }
    
    // Fallback: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}