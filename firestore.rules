rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isValidUser(userData) {
      return userData.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt', 'preferences']) &&
             userData.uid is string &&
             userData.email is string &&
             userData.preferences is map;
    }
    
    function isValidEmotionLog(logData) {
      let requiredFields = ['userId', 'mood', 'emotions', 'createdAt', 'updatedAt'];
      let allowedFields = ['userId', 'mood', 'emotions', 'triggers', 'context', 'intensity', 'createdAt', 'updatedAt'];
      
      return logData.keys().hasAll(requiredFields) &&
             logData.keys().hasOnly(allowedFields) &&
             logData.mood is number &&
             logData.mood >= 0 &&
             logData.mood <= 6 &&
             logData.emotions is list &&
             logData.emotions.size() <= 10 &&
             (!logData.keys().hasAny(['triggers']) || logData.triggers is list) &&
             (!logData.keys().hasAny(['context']) || logData.context is string) &&
             (!logData.keys().hasAny(['intensity']) || (logData.intensity is number && logData.intensity >= 1 && logData.intensity <= 10));
    }
    
    function isValidJournalEntry(entryData) {
      return entryData.keys().hasAll(['userId', 'title', 'content', 'entryType', 'isDraft', 'date', 'createdAt', 'updatedAt']) &&
             entryData.title is string &&
             entryData.content is string &&
             entryData.entryType in ['text', 'voice', 'video'] &&
             entryData.isDraft is bool;
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      
      // Emotion logs subcollection
      match /emotionLogs/{logId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEmotionLog(request.resource.data);
        allow update: if isOwner(userId) && isValidEmotionLog(request.resource.data);
      }
      
      // Journal entries subcollection
      match /journalEntries/{entryId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && isValidJournalEntry(request.resource.data);
        allow update: if isOwner(userId) && isValidJournalEntry(request.resource.data);
      }
      
      // User values subcollection
      match /values/{valueId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && 
                         request.resource.data.keys().hasAll(['userId', 'values', 'createdAt', 'updatedAt']) &&
                         request.resource.data.values is list;
      }
      
      
      // Soulspace items subcollection
      match /soulspaceItems/{itemId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && 
                         request.resource.data.keys().hasAll(['userId', 'type', 'title', 'content', 'isPrivate', 'createdAt', 'updatedAt']) &&
                         request.resource.data.type in ['note', 'image', 'audio', 'video', 'link'] &&
                         request.resource.data.title is string &&
                         request.resource.data.content is string &&
                         request.resource.data.isPrivate is bool;
      }
      
      // Analytics subcollection
      match /analytics/{analyticsId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && 
                         request.resource.data.keys().hasAll(['userId', 'period', 'date', 'emotionStats', 'journalStats', 'createdAt']) &&
                         request.resource.data.period in ['daily', 'weekly', 'monthly'] &&
                         request.resource.data.emotionStats is map &&
                         request.resource.data.journalStats is map;
      }
    }
    
    // Unified moments collection (top level for server access)
    match /moments/{momentId} {
      // Allow read if user owns the moment
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow create if user is creating their own moment with valid data
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.keys().hasAll(['userId', 'type', 'content', 'timestamp']) &&
                       request.resource.data.type in ['journal', 'emotion', 'voice', 'photo', 'video', 'chat'] &&
                       request.resource.data.userId is string &&
                       request.resource.data.content is string;
      
      // Allow update if user owns the moment
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow delete if user owns the moment
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Keep legacy moments subcollection for backward compatibility
    match /users/{userId}/moments/{momentId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['userId', 'type', 'content', 'timestamp', 'createdAt', 'updatedAt']) &&
                       request.resource.data.type in ['journal', 'emotion', 'voice', 'photo', 'video', 'chat'] &&
                       request.resource.data.userId is string &&
                       request.resource.data.content is string;
      allow update: if isOwner(userId);
    }
    
    // Vector metadata collection (top level for server access)
    match /vectorMetadata/{metadataId} {
      // Allow read/update/delete if user owns the metadata
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow create if user is creating their own metadata
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.keys().hasAll(['userId', 'momentId']) &&
                       request.resource.data.userId is string &&
                       request.resource.data.momentId is string;
    }
    
    // Keep legacy vectorMetadata subcollection for backward compatibility
    match /users/{userId}/vectorMetadata/{metadataId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['userId', 'momentId']) &&
                       request.resource.data.userId is string &&
                       request.resource.data.momentId is string;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
